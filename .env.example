# SentinelAI Environment Configuration
# ====================================

# Operator Security Token (Required for remote admin mutations & recommended for production)
# When set, protected admin routes require X-Sentinel-Token: <token>
SENTINEL_ADMIN_TOKEN=

# Set to 'true' ONLY if proxying private/localhost targets during local development
SENTINEL_ALLOW_PRIVATE_UPSTREAM=false

# Set to 'false' to require SENTINEL_ADMIN_TOKEN even from localhost
SENTINEL_ALLOW_LOCALHOST_DEV=true

# Optional: Custom SQLite telemetry & quarantine database path
# SENTINEL_DB_PATH=data/traffic.db

# Optional: Default protected upstream site URL
# SENTINEL_TARGET_URL=https://aai-ji-honey.vercel.app

# Google Gemini API Key for deep SOC incident reasoning
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default Gemini model
SENTINEL_GEMINI_MODEL=gemini-1.5-flash

# Optional: Local Ollama daemon configuration
OLLAMA_HOST=http://localhost:11434
SENTINEL_OLLAMA_MODEL=llama3.2
